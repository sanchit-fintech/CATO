# Copy this file to .env and add your own key. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Separate multiple roots with the platform path separator (":" on macOS/Linux).
# Relative paths are resolved from the directory where Cato is launched.
CATO_APPROVED_ROOTS=.
LOG_LEVEL=INFO
CATO_MAX_AGENT_ITERATIONS=8
CATO_MAX_FILE_READ_BYTES=1000000
CATO_MAX_COMMAND_OUTPUT_BYTES=20000
CATO_COMMAND_TIMEOUT=10
CATO_HISTORY_LIMIT=50
CATO_API_HOST=127.0.0.1
CATO_API_PORT=8000
CATO_APPROVAL_TTL_SECONDS=300
CATO_MAX_CLIPBOARD_BYTES=100000
CATO_ALLOWED_MACOS_APPS=Finder,Safari,Terminal,Visual Studio Code,Notes
